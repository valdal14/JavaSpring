<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- 1. Tell Spring to load the properties file from the classpath -->
    <context:property-placeholder location="classpath:application.properties" />
    <!-- This activates the annotations like @Autowired and @Required inside our beans -->
    <context:annotation-config />

    <bean id="beanA" class="com.vd14.annotations.BeanA" />

    <!-- New Annotations -->
    <bean id="beanC" class="com.vd14.annotations.BeanC"/>

    <bean id="beanD" class="com.vd14.annotations.BeanD">
        <property name="id" value="123456"/>
    </bean>

    <bean id="injectBeanOne" class="com.vd14.annotations.InjectBeanOne">
        <property name="beanC" ref="beanC"/>
    </bean>

    <bean id="injectBeanTwo" class="com.vd14.annotations.InjectBeanTwo">
        <property name="beanD" ref="beanD"/>
    </bean>

    <bean id="beanB" class="com.vd14.annotations.BeanB">
        <constructor-arg ref="injectBeanOne" />
        <constructor-arg ref="injectBeanTwo" />
    </bean>

</beans>