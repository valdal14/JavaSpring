<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans 
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context 
        http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- Component Scan and Annotation Config -->
    <context:annotation-config />
    <!-- This activates the annotations like @Autowired and @Required inside our beans -->
    <context:annotation-config />
    <!-- Tells Spring to scan this folder and its sub-folders for @Component, @Service, etc. -->
    <!-- Enter your component scan qualifier (com.domain.feature) -->
    <context:component-scan base-package="com.vd14.qualifiers" />

    <bean id="beanA" class="com.vd14.qualifiers.BeanA"/>

    <bean id="beanB1" class="com.vd14.qualifiers.BeanB">
        <property name="myProperty" value="Test1"/>
    </bean>
    <bean id="beanB2" class="com.vd14.qualifiers.BeanB">
        <property name="myProperty" value="Test2"/>
        <qualifier type="com.vd14.qualifiers.CustomBeanAnnotation"/>
    </bean>
    
</beans>